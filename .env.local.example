DATABASE_URL=
RESEND_API_KEY=
NOTIFICATION_EMAIL=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=
GEMINI_API_KEY=
MF_CLIENT_ID=
MF_CLIENT_SECRET=
MF_REDIRECT_URI=
MF_EXPENSE_ACCOUNTS=
MF_OFFICE_ID=
APP_PASSWORD=
AUTH_SECRET=
# MoneyForwardトークンをDB保存する際の暗号化鍵（32バイト）。生成: openssl rand -base64 32
# 未設定だとMF連携は保存できず未連携扱いになる。設定/変更後は一度MF再連携が必要。
ENCRYPTION_KEY=
# 任意（未設定時は既定値を使用）: セッション有効期限とログインのレート制限
SESSION_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=10
# 任意（未設定時は既定値を使用）: 税務AIのモデル名と、アドバイスアップロードのサイズ上限（バイト、既定5MB）
GEMINI_MODEL=gemini-2.0-flash
UPLOAD_MAX_BYTES=5242880
# 任意（未設定時は既定値を使用）: 月次生成cronが何日成功していなければアラートするか（既定35日）
CRON_STALE_ALERT_DAYS=35
# 任意: 照合OKになった請求書PDFのGoogleドライブ自動保存。すべてそろって初めて有効になり、
# 未設定なら保存を行わない（判定理由にも何も出ない）。
# 保存はユーザー本人のGoogleアカウント名義（＝本人のドライブ容量）で行うため、
# 環境変数を入れたうえでマスタ管理画面から一度「Googleと連携する」を実行する必要がある。
# CLIENT_ID / CLIENT_SECRET は Google Cloud の「OAuth 2.0 クライアント ID（ウェブアプリケーション）」の値。
# REDIRECT_URI は Google Cloud 側の「承認済みのリダイレクト URI」と完全一致させる
# （例: https://ドメイン/api/google-drive/callback）。
# FOLDER_ID は保存先の親フォルダのID（この配下に「26/9」形式の月フォルダを作る）。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_FOLDER_ID=
# 任意: 請求書の未提出リマインド（Chatwork）。未設定なら送信ボタンを押しても「未設定」と返る。
# 毎月10日9:00(JST)の自動送信にも使う。自動送信は受付URLの組み立てに NEXT_PUBLIC_APP_URL が必須で、
# どちらかが未設定なら送信せずエラーを返す（URLの無い催促文を送らないため）。
# トークンは Chatwork の「サービス連携 > API Token」で発行する。
# 送信先は委託者マスタの「ChatworkルームID」（その人とのチャットURLの #!rid の後ろの数字）。
CHATWORK_API_TOKEN=
# 任意（未設定時は既定値を使用）: リマインド文面のたたき台。改行は \n で書く。
# {name}=委託者名 / {month}=請求書の対象月（支払月の前月） / {url}=請求書受付URL
INVOICE_REMINDER_TEMPLATE=
